{
    "name": "kfoobar/laravel-theme",
    "description": "Theme support for Laravel",
    "keywords": [
        "laravel",
        "theme",
        "multisite"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8",
        "ext-json": "*",
        "illuminate/config": "^8.0||^9.0||^10.0",
        "illuminate/console": "^8.0||^9.0||^10.0",
        "illuminate/contracts": "^8.0||^9.0||^10.0",
        "illuminate/database": "^8.0||^9.0||^10.0",
        "illuminate/filesystem": "^8.0||^9.0||^10.0",
        "illuminate/support": "^8.0||^9.0||^10.0",
        "illuminate/view": "^8.0||^9.0||^10.0"
    },
    "autoload": {
        "psr-4": {
            "KFoobar\\Theme\\": "src/"
        },
        "files": [
            "src/Helpers/ThemeHelper.php"
        ]
    },
    "authors": [
        {
            "name": "David Villa",
            "email": "david@kfoobar.se"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "KFoobar\\Theme\\ThemeServiceProvider"
            ],
            "aliases": {
                "Theme": "KFoobar\\Theme\\Facades\\Theme"
            }
        }
    },
    "require-dev": {
        "orchestra/testbench": "^6.0 || ^7.0 || ^8.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "KFoobar\\Theme\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
